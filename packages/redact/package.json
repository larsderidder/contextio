{
  "name": "@contextio/redact",
  "version": "0.3.1",
  "description": "Privacy and redaction layer for LLM API calls",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./factory": {
      "types": "./dist/factory.d.ts",
      "import": "./dist/factory.js",
      "require": "./dist/factory.js",
      "default": "./dist/factory.js"
    }
  },
  "files": [
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/larsderidder/contextio.git",
    "directory": "packages/redact"
  },
  "homepage": "https://github.com/larsderidder/contextio#readme",
  "bugs": "https://github.com/larsderidder/contextio/issues",
  "keywords": [
    "llm",
    "redact",
    "privacy",
    "pii",
    "security"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@contextio/core": "workspace:*",
    "@huggingface/tokenizers": "^0.1.3",
    "@siddicky/anonymizerts": "^1.0.3",
    "onnxruntime-node": "^1.20.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "better-sqlite3": "^11.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "execa": "^9.0.0",
    "typescript": "^5.7"
  }
}
